amqp_urls=amqp://user:password@rabbitmq/
rpc_urls=rpc://
celery_concurrency=4
result_queue_name=common-results-queue
exchange_name=default_exchange
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
JWT_SECRET_KEY=replace-with-a-random-256-bit-secret

POSTGRES_DEFAULT_USER=postgres
POSTGRES_DEFAULT_PASSWORD=change-this-local-password
POSTGRES_DATABASE_NAME=miminet
POSTGRES_HOST=postgres

BASE_DOMAIN=local.tst
QUIZ_DOMAIN=quiz.${BASE_DOMAIN}
EXTERNAL_BASE_URL=/
QUIZ_URL=http://${QUIZ_DOMAIN}
ALLOWED_HOSTS=http://${BASE_DOMAIN},${QUIZ_URL},http://127.0.0.1,http://localhost
ACCESS_TOKEN_EXPIRES=3
REFRESH_TOKEN_EXPIRES=12
MODE=dev
JWT_COOKIE_DOMAIN=
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_EMAIL=developer@miminet.local
LOCAL_AUTH_PASSWORD=change-this-local-password
LOCAL_AUTH_NICK=local developer
